# 환경변수 (API 키 등) - 절대 Git에 업로드하지 마세요
.env
# 로컬에 보관하는 API 키 파일 (절대 커밋 금지)
config/APIkey

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# 가상환경
.venv/
venv/
env/

# 출력 결과 (선택적으로 추적 제외)
outputs/
outputs_*
# 재구조화 이전 폴더 (실제 실행 결과·이미지 자산이 들어 있음, 사람이 옮길 때까지 추적 제외)
images/
output/
# 입력 자산 (사진·컬러 패턴은 사람이 배치하는 작업물, 가이드라인만 추적)
inputs/*
!inputs/guides/
!inputs/photos/
!inputs/photos/.gitkeep
!inputs/color_patterns/
!inputs/color_patterns/.gitkeep
inputs/photos/*
!inputs/photos/.gitkeep
inputs/color_patterns/*
!inputs/color_patterns/.gitkeep

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# macOS
.DS_Store

# 로그
*.log

.codegraph
