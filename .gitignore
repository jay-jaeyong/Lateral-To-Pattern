# ─────────────────────────────────────────────────────────────
# 이 저장소는 '코드와 설정'만 추적합니다.
# 이미지·결과물·문서·데이터 파일은 전부 로컬 보관(무시)입니다.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# 비밀 정보 (절대 커밋 금지)
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
config/APIkey

# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
.eggs/
build/
dist/

# 캐시 / 테스트 도구
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 가상환경
.venv/
venv/
env/

# ─────────────────────────────────────────────────────────────
# 데이터 폴더 (입력·출력·결과물 전부 로컬 전용)
# ─────────────────────────────────────────────────────────────
data/
output/
final_data/
잘된애들/

# 단계별 이미지 생성 폴더 — 폴더 구조(.gitkeep)만 추적
images/*
!images/*/
images/*/*
!images/*/.gitkeep

# ─────────────────────────────────────────────────────────────
# 이미지 / 미디어 (어느 경로에 있든 무시)
# ─────────────────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.heic
*.svg
*.ico
*.psd
*.ai
*.eps
*.mp4
*.mov
*.avi
*.webm

# ─────────────────────────────────────────────────────────────
# 문서 / 발표자료
# ─────────────────────────────────────────────────────────────
*.pdf
*.ppt
*.pptx
*.pptm
*.key
*.doc
*.docx
*.xls
*.xlsx
*.hwp
*.hwpx

# Office 임시 잠금 파일 (~$연구.pptx 같은 것)
~$*

# ─────────────────────────────────────────────────────────────
# 데이터 파일 / 압축
# ─────────────────────────────────────────────────────────────
*.csv
*.tsv
*.parquet
*.npy
*.npz
*.pkl
*.pickle
*.sqlite
*.sqlite3
*.db

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ─────────────────────────────────────────────────────────────
# 에디터 / OS
# ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# 로그
*.log
